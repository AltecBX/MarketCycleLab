{
  // Cloudflare Workers configuration. `npm run build` writes the app to ./dist,
  // then `npx wrangler deploy` uploads it with the worker below.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketcyclelab",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths such as /research/NVDA/overview return the app shell.
    "not_found_handling": "single-page-application",
    // The password gate runs before any file is served.
    "run_worker_first": true
  },
  // Keep variables set in the dashboard when a deploy runs.
  "keep_vars": true,
  "observability": { "enabled": true }
}
